# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Google Gemini API key (set METESPARSER_LLM_PROVIDER=gemini to use)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenRouter API key (set METESPARSER_LLM_PROVIDER=openrouter to use)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional OpenRouter overrides (default: anthropic/claude-haiku-5.5, fallback: anthropic/claude-sonnet-5.5, reasoning_effort: low):
# For harder / degraded scans, use anthropic/claude-sonnet-5.5 with reasoning_effort=low (and optionally pdf_engine=mistral-ocr):
# Set OPENROUTER_FALLBACK_MODEL to off/none/empty to disable fallback, or OPENROUTER_REASONING_EFFORT to off/empty to omit reasoning:
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# OPENROUTER_FALLBACK_MODEL=google/gemini-3.6-flash
# OPENROUTER_PDF_ENGINE=mistral-ocr
# OPENROUTER_REASONING_EFFORT=low

# LLM Provider (openai, gemini, or openrouter)
METESPARSER_LLM_PROVIDER=openai

# Logging Configuration
METESPARSER_LOG_LEVEL=INFO
METESPARSER_LOG_FORMAT=console
