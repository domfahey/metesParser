!sample_deeds/*.pdf
!sample_deeds/**/*.pdf
# Allow reference PDFs in docs
!docs/reference/*.pdf
# Legacy delivery-1 replay golden (test evidence)
!packages/mp-review/tests/fixtures/delivery-1-golden/deliveries/*/drawing.pdf

