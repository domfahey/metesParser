{
  "$defs": {
    "BearingBasis": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "source_references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source References",
          "type": "array"
        }
      },
      "required": [
        "label"
      ],
      "title": "BearingBasis",
      "type": "object"
    },
    "ComparisonDescription": {
      "additionalProperties": false,
      "properties": {
        "bearing_basis": {
          "$ref": "#/$defs/BearingBasis"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlotPlacement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plot": {
          "$ref": "#/$defs/PlotRequest"
        }
      },
      "required": [
        "id",
        "plot",
        "bearing_basis"
      ],
      "title": "ComparisonDescription",
      "type": "object"
    },
    "ComparisonPair": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "left": {
          "$ref": "#/$defs/ComparisonSelection"
        },
        "right": {
          "$ref": "#/$defs/ComparisonSelection"
        }
      },
      "required": [
        "id",
        "left",
        "right"
      ],
      "title": "ComparisonPair",
      "type": "object"
    },
    "ComparisonSelection": {
      "additionalProperties": false,
      "properties": {
        "call_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Call Ids",
          "type": "array"
        },
        "direction": {
          "enum": [
            "forward",
            "reverse"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "call_ids",
        "direction"
      ],
      "title": "ComparisonSelection",
      "type": "object"
    },
    "ComparisonTolerance": {
      "additionalProperties": false,
      "properties": {
        "bearing_deg": {
          "exclusiveMaximum": 180,
          "minimum": 0,
          "title": "Bearing Deg",
          "type": "number"
        },
        "displacement": {
          "minimum": 0,
          "title": "Displacement",
          "type": "number"
        },
        "length": {
          "minimum": 0,
          "title": "Length",
          "type": "number"
        },
        "linear_unit": {
          "enum": [
            "international_ft",
            "us_survey_ft",
            "m",
            "unknown_ft"
          ],
          "title": "Linear Unit",
          "type": "string"
        },
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "number"
        },
        "source_references": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source References",
          "type": "array"
        }
      },
      "required": [
        "length",
        "displacement",
        "position",
        "linear_unit",
        "bearing_deg",
        "source_references"
      ],
      "title": "ComparisonTolerance",
      "type": "object"
    },
    "ComparisonTransform": {
      "additionalProperties": false,
      "description": "Explicit clockwise rigid transform from right native frame to left frame.",
      "properties": {
        "rotation_deg": {
          "title": "Rotation Deg",
          "type": "number"
        },
        "source_references": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source References",
          "type": "array"
        },
        "translation": {
          "default": [
            0.0,
            0.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Translation",
          "type": "array"
        }
      },
      "required": [
        "rotation_deg",
        "source_references"
      ],
      "title": "ComparisonTransform",
      "type": "object"
    },
    "DeedCall": {
      "additionalProperties": false,
      "description": "Represents a single metes and bounds call (course/line).",
      "properties": {
        "along": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the line runs along (e.g., 'Southerly line of Pennbrook Drive')",
          "title": "Along"
        },
        "arc_length_ft": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Arc length in feet",
          "title": "Arc Length Ft"
        },
        "bearing_azimuth_deg_from_north": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Azimuth in degrees clockwise from North (0-360)",
          "title": "Bearing Azimuth Deg From North"
        },
        "bearing_quadrant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Quadrant bearing if specified (e.g., 'S 56°40' W')",
          "title": "Bearing Quadrant"
        },
        "chord_bearing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Chord bearing",
          "title": "Chord Bearing"
        },
        "chord_length_ft": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Chord length in feet",
          "title": "Chord Length Ft"
        },
        "course": {
          "description": "Sequential course number (1, 2, 3, ...)",
          "minimum": 1,
          "title": "Course",
          "type": "integer"
        },
        "curve_dir": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Curve direction (left/right)",
          "title": "Curve Dir"
        },
        "curve_type": {
          "anyOf": [
            {
              "enum": [
                "simple",
                "compound",
                "reverse",
                "spiral"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Type of curve: simple, compound, or reverse (None for non-curves)",
          "title": "Curve Type"
        },
        "delta_deg": {
          "anyOf": [
            {
              "maximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Central angle (Δ) in degrees",
          "title": "Delta Deg"
        },
        "direction_text": {
          "description": "Verbatim direction from deed (e.g., 'S 56°40' W' or 'southwesterly')",
          "minLength": 1,
          "title": "Direction Text",
          "type": "string"
        },
        "distance_ft": {
          "description": "Distance in decimal feet",
          "exclusiveMinimum": 0,
          "title": "Distance Ft",
          "type": "number"
        },
        "is_exception": {
          "default": false,
          "description": "True if this call is part of an exception/exclusion tract",
          "title": "Is Exception",
          "type": "boolean"
        },
        "is_indefinite": {
          "default": false,
          "description": "True if this call has vague direction without precise bearing",
          "title": "Is Indefinite",
          "type": "boolean"
        },
        "is_meander": {
          "default": false,
          "description": "True if this call follows a water boundary (meander line)",
          "title": "Is Meander",
          "type": "boolean"
        },
        "is_tie_in": {
          "default": false,
          "description": "True if this call is a tie-in call between POC and POB",
          "title": "Is Tie In",
          "type": "boolean"
        },
        "monument_status": {
          "anyOf": [
            {
              "enum": [
                "found",
                "set"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether monument text indicates found or set",
          "title": "Monument Status"
        },
        "monument_type": {
          "anyOf": [
            {
              "enum": [
                "iron_rod",
                "iron_pin",
                "iron_pipe",
                "stone",
                "concrete",
                "wooden_post",
                "brass_cap",
                "rebar",
                "railroad_spike",
                "nail",
                "pk_nail",
                "hub_and_tack",
                "monitoring_well",
                "capped_pin",
                "capped_rod",
                "txdot_monument",
                "tree",
                "rock",
                "natural_feature",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Type of survey monument at endpoint",
          "title": "Monument Type"
        },
        "non_tangent": {
          "default": false,
          "description": "True if this curve is non-tangent (radial bearing provided)",
          "title": "Non Tangent",
          "type": "boolean"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Additional notes (meander flag, issues, etc.)",
          "title": "Notes"
        },
        "quality": {
          "anyOf": [
            {
              "enum": [
                "high",
                "medium",
                "low"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Call quality rating based on bearing completeness and monument permanence",
          "title": "Quality"
        },
        "radial_bearing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Radial bearing for non-tangent curves (e.g., 'N 15°22' E')",
          "title": "Radial Bearing"
        },
        "radius_ft": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Curve radius in feet",
          "title": "Radius Ft"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ending point description (e.g., 'iron pin', 'corner to Lot 50')",
          "title": "To"
        }
      },
      "required": [
        "course",
        "direction_text",
        "distance_ft"
      ],
      "title": "DeedCall",
      "type": "object"
    },
    "LocalFrame": {
      "additionalProperties": false,
      "description": "Explicit arbitrary frame, in feet; azimuth is clockwise from local +Y.\n\nOrientation sets the interior/exterior-angle interpretation convention and\ncomputed closing angle. It does not certify the winding of the resulting\nboundary. Explicit perpendicular/parallel directions are independent of it.",
      "properties": {
        "first_azimuth_deg": {
          "title": "First Azimuth Deg",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "orientation": {
          "enum": [
            "cw",
            "ccw"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "origin": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Origin",
          "type": "array"
        }
      },
      "required": [
        "name",
        "first_azimuth_deg",
        "origin",
        "orientation"
      ],
      "title": "LocalFrame",
      "type": "object"
    },
    "PlotCall": {
      "additionalProperties": false,
      "description": "A supplied call and optional actual source references, never invented pages.",
      "properties": {
        "call": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeedCall"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "occurrence_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurrence Id"
        },
        "page_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Id"
        },
        "quote": {
          "default": "",
          "title": "Quote",
          "type": "string"
        },
        "source_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reference"
        }
      },
      "required": [
        "id",
        "call"
      ],
      "title": "PlotCall",
      "type": "object"
    },
    "PlotPlacement": {
      "additionalProperties": false,
      "properties": {
        "baseline_geometry_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Geometry Hash"
        },
        "baseline_placement_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Placement Id"
        },
        "calculation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Calculation Id",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "geometry_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Geometry Hash",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "orientation_evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Orientation Evidence",
          "type": "array"
        },
        "position_evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Position Evidence",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "rotation_deg": {
          "default": 0.0,
          "title": "Rotation Deg",
          "type": "number"
        },
        "scenario_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        },
        "scene_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Scene Id",
          "type": "string"
        },
        "status": {
          "default": "approximate",
          "enum": [
            "unplaced",
            "approximate",
            "referenced"
          ],
          "title": "Status",
          "type": "string"
        },
        "translation": {
          "default": [
            0.0,
            0.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Translation",
          "type": "array"
        }
      },
      "required": [
        "id",
        "calculation_id",
        "geometry_hash",
        "scene_id",
        "rationale"
      ],
      "title": "PlotPlacement",
      "type": "object"
    },
    "PlotRequest": {
      "additionalProperties": false,
      "description": "Calls to plot in an unadjusted local frame, independently of a dashboard.",
      "properties": {
        "calculation_id": {
          "default": "plot",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Calculation Id",
          "type": "string"
        },
        "calls": {
          "items": {
            "$ref": "#/$defs/PlotCall"
          },
          "minItems": 1,
          "title": "Calls",
          "type": "array"
        },
        "foot_definition": {
          "default": "unknown_ft",
          "enum": [
            "international_ft",
            "us_survey_ft",
            "m",
            "unknown_ft"
          ],
          "title": "Foot Definition",
          "type": "string"
        },
        "relative": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelativeDescription"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "calls"
      ],
      "title": "PlotRequest",
      "type": "object"
    },
    "PlotScene": {
      "additionalProperties": false,
      "properties": {
        "axis_order": {
          "const": "xy",
          "default": "xy",
          "title": "Axis Order",
          "type": "string"
        },
        "basis": {
          "default": "local",
          "title": "Basis",
          "type": "string"
        },
        "crs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crs"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "local",
            "projected"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "units": {
          "enum": [
            "international_ft",
            "us_survey_ft",
            "m",
            "unknown_ft"
          ],
          "title": "Units",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "units"
      ],
      "title": "PlotScene",
      "type": "object"
    },
    "RelativeConstraint": {
      "additionalProperties": false,
      "description": "Relation from one directed course to another.\n\nInterior/exterior angles connect successive boundary courses (last to first\nis the closing angle). Exterior values require an explicit convention that\ninterior = 360 - exterior; an unspecified convention stays unresolved.\nPerpendicular turns and parallel direction refer to the directed from_course,\nso they also work for nonadjacent courses. Unspecified choices stay unresolved.",
      "properties": {
        "angle_deg": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angle Deg"
        },
        "constraint_id": {
          "title": "Constraint Id",
          "type": "string"
        },
        "exterior_convention": {
          "anyOf": [
            {
              "const": "interior_complement",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exterior Convention"
        },
        "from_course": {
          "title": "From Course",
          "type": "string"
        },
        "interpretation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interpretation"
        },
        "kind": {
          "enum": [
            "interior",
            "exterior",
            "perpendicular",
            "parallel"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parallel_direction": {
          "anyOf": [
            {
              "enum": [
                "same",
                "opposite"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parallel Direction"
        },
        "source": {
          "$ref": "#/$defs/RelativeSource"
        },
        "to_course": {
          "title": "To Course",
          "type": "string"
        },
        "turn": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn"
        }
      },
      "required": [
        "constraint_id",
        "kind",
        "from_course",
        "to_course",
        "source"
      ],
      "title": "RelativeConstraint",
      "type": "object"
    },
    "RelativeCourse": {
      "additionalProperties": false,
      "description": "One straight course; recorded bearings are retained but never inferred.",
      "properties": {
        "course_id": {
          "title": "Course Id",
          "type": "string"
        },
        "distance_ft": {
          "exclusiveMinimum": 0,
          "title": "Distance Ft",
          "type": "number"
        },
        "recorded_bearing_azimuth_deg_from_north": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
