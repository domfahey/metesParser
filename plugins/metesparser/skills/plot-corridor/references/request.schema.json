{
  "$defs": {
    "CorridorErrorBudget": {
      "additionalProperties": false,
      "properties": {
        "max_error": {
          "exclusiveMinimum": 0,
          "title": "Max Error",
          "type": "number"
        },
        "unit": {
          "enum": [
            "international_ft",
            "us_survey_ft",
            "m",
            "unknown_ft"
          ],
          "title": "Unit",
          "type": "string"
        },
        "max_segments": {
          "default": 2048,
          "maximum": 16384,
          "minimum": 4,
          "title": "Max Segments",
          "type": "integer"
        }
      },
      "required": [
        "max_error",
        "unit"
      ],
      "title": "CorridorErrorBudget",
      "type": "object"
    },
    "CorridorStation": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Call Id",
          "type": "string"
        },
        "fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Fraction",
          "type": "number"
        }
      },
      "required": [
        "call_id",
        "fraction"
      ],
      "title": "CorridorStation",
      "type": "object"
    },
    "CorridorWidthInterval": {
      "additionalProperties": false,
      "description": "Widths are relative to forward centerline traversal, never averaged per call.\n\nA step row is constant on its interval; a different next row explicitly creates\na width jump. A taper interpolates each side linearly in centerline arc length.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/CorridorStation"
        },
        "end": {
          "$ref": "#/$defs/CorridorStation"
        },
        "left_start": {
          "minimum": 0,
          "title": "Left Start",
          "type": "number"
        },
        "left_end": {
          "minimum": 0,
          "title": "Left End",
          "type": "number"
        },
        "right_start": {
          "minimum": 0,
          "title": "Right Start",
          "type": "number"
        },
        "right_end": {
          "minimum": 0,
          "title": "Right End",
          "type": "number"
        },
        "rule": {
          "enum": [
            "step",
            "linear_taper"
          ],
          "title": "Rule",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/DiagnosticSourceRef"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "left_start",
        "left_end",
        "right_start",
        "right_end",
        "rule",
        "source_refs"
      ],
      "title": "CorridorWidthInterval",
      "type": "object"
    },
    "DeedCall": {
      "additionalProperties": false,
      "description": "Represents a single metes and bounds call (course/line).",
      "properties": {
        "course": {
          "description": "Sequential course number (1, 2, 3, ...)",
          "minimum": 1,
          "title": "Course",
          "type": "integer"
        },
        "direction_text": {
          "description": "Verbatim direction from deed (e.g., 'S 56°40' W' or 'southwesterly')",
          "minLength": 1,
          "title": "Direction Text",
          "type": "string"
        },
        "bearing_quadrant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Quadrant bearing if specified (e.g., 'S 56°40' W')",
          "title": "Bearing Quadrant"
        },
        "bearing_azimuth_deg_from_north": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Azimuth in degrees clockwise from North (0-360)",
          "title": "Bearing Azimuth Deg From North"
        },
        "distance_ft": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Distance in decimal feet; None only for a spiral whose length is not stated (not determinable without fabrication)",
          "title": "Distance Ft"
        },
        "curve_dir": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Curve direction (left/right)",
          "title": "Curve Dir"
        },
        "radius_ft": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Curve radius in feet",
          "title": "Radius Ft"
        },
        "delta_deg": {
          "anyOf": [
            {
              "maximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Central angle (Δ) in degrees",
          "title": "Delta Deg"
        },
        "arc_length_ft": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Arc length in feet; for a spiral, the stated spiral length (never R * delta)",
          "title": "Arc Length Ft"
        },
        "chord_bearing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Chord bearing",
          "title": "Chord Bearing"
        },
        "chord_length_ft": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Chord length in feet",
          "title": "Chord Length Ft"
        },
        "along": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the line runs along (e.g., 'Southerly line of Pennbrook Drive')",
          "title": "Along"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ending point description (e.g., 'iron pin', 'corner to Lot 50')",
          "title": "To"
        },
        "monument_status": {
          "anyOf": [
            {
              "enum": [
                "found",
                "set"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether monument text indicates found or set",
          "title": "Monument Status"
        },
        "monument_type": {
          "anyOf": [
            {
              "enum": [
                "iron_rod",
                "iron_pin",
                "iron_pipe",
                "stone",
                "concrete",
                "wooden_post",
                "brass_cap",
                "rebar",
                "railroad_spike",
                "nail",
                "pk_nail",
                "hub_and_tack",
                "monitoring_well",
                "capped_pin",
                "capped_rod",
                "txdot_monument",
                "tree",
                "rock",
                "natural_feature",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Type of survey monument at endpoint",
          "title": "Monument Type"
        },
        "is_exception": {
          "default": false,
          "description": "True if this call is part of an exception/exclusion tract",
          "title": "Is Exception",
          "type": "boolean"
        },
        "non_tangent": {
          "default": false,
          "description": "True if this curve is non-tangent (radial bearing provided)",
          "title": "Non Tangent",
          "type": "boolean"
        },
        "radial_bearing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Radial bearing for non-tangent curves (e.g., 'N 15°22' E')",
          "title": "Radial Bearing"
        },
        "is_meander": {
          "default": false,
          "description": "True if this call follows a water boundary (meander line)",
          "title": "Is Meander",
          "type": "boolean"
        },
        "is_tie_in": {
          "default": false,
          "description": "True if this call is a tie-in call between POC and POB",
          "title": "Is Tie In",
          "type": "boolean"
        },
        "is_indefinite": {
          "default": false,
          "description": "True if this call has vague direction without precise bearing",
          "title": "Is Indefinite",
          "type": "boolean"
        },
        "curve_type": {
          "anyOf": [
            {
              "enum": [
                "simple",
                "compound",
                "reverse",
                "spiral"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Type of curve: simple, compound, or reverse (None for non-curves)",
          "title": "Curve Type"
        },
        "quality": {
          "anyOf": [
            {
              "enum": [
                "high",
                "medium",
                "low"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Call quality rating based on bearing completeness and monument permanence",
          "title": "Quality"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Additional notes (meander flag, issues, etc.)",
          "title": "Notes"
        }
      },
      "required": [
        "course",
        "direction_text",
        "distance_ft"
      ],
      "title": "DeedCall",
      "type": "object"
    },
    "DiagnosticSourceRef": {
      "additionalProperties": false,
      "description": "Source evidence when known; absent identity details remain unknown.",
      "properties": {
        "source_id": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "occurrence_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurrence Id"
        },
        "page": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "page_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Id"
        },
        "crop_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Id"
        },
        "span_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "DiagnosticSourceRef",
      "type": "object"
    },
    "LocalFrame": {
      "additionalProperties": false,
      "description": "Explicit arbitrary frame, in feet; azimuth is clockwise from local +Y.\n\nOrientation sets the interior/exterior-angle interpretation convention and\ncomputed closing angle. It does not certify the winding of the resulting\nboundary. Explicit perpendicular/parallel directions are independent of it.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "first_azimuth_deg": {
          "title": "First Azimuth Deg",
          "type": "number"
        },
        "origin": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Origin",
          "type": "array"
        },
        "orientation": {
          "enum": [
            "cw",
            "ccw"
          ],
          "title": "Orientation",
          "type": "string"
        }
      },
      "required": [
        "name",
        "first_azimuth_deg",
        "origin",
        "orientation"
      ],
      "title": "LocalFrame",
      "type": "object"
    },
    "PlotCall": {
      "additionalProperties": false,
      "description": "A supplied call and optional actual source references, never invented pages.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "call": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeedCall"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurrence_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurrence Id"
        },
        "page_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Id"
        },
        "source_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reference"
        },
        "quote": {
          "default": "",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "id",
        "call"
      ],
      "title": "PlotCall",
      "type": "object"
    },
    "PlotRequest": {
      "additionalProperties": false,
      "description": "Calls to plot in an unadjusted local frame, independently of a dashboard.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "calculation_id": {
          "default": "plot",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Calculation Id",
          "type": "string"
        },
        "calls": {
          "items": {
            "$ref": "#/$defs/PlotCall"
          },
          "minItems": 1,
          "title": "Calls",
          "type": "array"
        },
        "foot_definition": {
          "default": "unknown_ft",
          "enum": [
            "international_ft",
            "us_survey_ft",
            "m",
            "unknown_ft"
          ],
          "title": "Foot Definition",
          "type": "string"
        },
        "relative": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelativeDescription"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "title",
        "calls"
      ],
      "title": "PlotRequest",
      "type": "object"
    },
    "RelativeConstraint": {
      "additionalProperties": false,
      "description": "Relation from one directed course to another.\n\nInterior/exterior angles connect successive boundary courses (last to first\nis the closing angle). Exterior values require an explicit convention that\ninterior = 360 - exterior; an unspecified convention stays unresolved.\nPerpendicular turns and parallel direction refer to the directed from_course,\nso they also work for nonadjacent courses. Unspecified choices stay unresolved.",
      "properties": {
        "constraint_id": {
          "title": "Constraint Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "interior",
            "exterior",
            "perpendicular",
            "parallel"
          ],
          "title": "Kind",
          "type": "string"
        },
        "from_course": {
          "title": "From Course",
          "type": "string"
        },
        "to_course": {
          "title": "To Course",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/RelativeSource"
        },
        "angle_deg": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angle Deg"
        },
        "turn": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn"
        },
        "parallel_direction": {
          "anyOf": [
            {
              "enum": [
                "same",
                "opposite"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parallel Direction"
        },
        "exterior_convention": {
          "anyOf": [
            {
              "const": "interior_complement",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exterior Convention"
        },
        "interpretation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interpretation"
        }
      },
      "required": [
        "constraint_id",
        "kind",
        "from_course",
        "to_course",
        "source"
      ],
      "title": "RelativeConstraint",
      "type": "object"
    },
    "RelativeCourse": {
      "additionalProperties": false,
      "description": "One straight course; recorded bearings are retained but never inferred.",
      "properties": {
        "course_id": {
          "title": "Course Id",
          "type": "string"
        },
        "distance_ft": {
          "exclusiveMinimum": 0,
          "title": "Distance Ft",
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/RelativeSource"
        },
        "recorded_bearing_azimuth_deg_from_north": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded Bearing Azimuth Deg From North"
        }
      },
      "required": [
        "course_id",
        "distance_ft",
        "source"
      ],
      "title": "RelativeCourse",
      "type": "object"
    },
    "RelativeDescription": {
      "additionalProperties": false,
      "description": "A source-linked straight boundary plus explicit local interpretation.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "frame": {
          "$ref": "#/$defs/LocalFrame"
        },
        "courses": {
          "items": {
            "$ref": "#/$defs/RelativeCourse"
          },
          "minItems": 3,
          "title": "Courses",
          "type": "array"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/RelativeConstraint"
          },
          "title": "Constraints",
          "type": "array"
        }
      },
      "required": [
        "frame",
        "courses",
        "constraints"
      ],
      "title": "RelativeDescription",
      "type": "object"
    },
    "RelativeSource": {
      "additionalProperties": false,
      "description": "Verbatim evidence plus a document/page/occurrence reference.",
      "properties": {
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "quote"
      ],
      "title": "RelativeSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An explicit construction, including user-selected join/cap conventions.\n\nSquare caps extend by half the total endpoint width. Round caps have the\nleft/right endpoint diameter, whose center may lie off an asymmetric centerline.\nThese choices record instructions, not inferred surveyed intent.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "title": "Id",
      "type": "string"
    },
    "centerline": {
      "$ref": "#/$defs/PlotRequest"
    },
    "widths": {
      "items": {
        "$ref": "#/$defs/CorridorWidthInterval"
      },
      "title": "Widths",
      "type": "array"
    },
    "width_unit": {
      "enum": [
        "international_ft",
        "us_survey_ft",
        "m",
        "unknown_ft"
      ],
      "title": "Width Unit",
      "type": "string"
    },
    "side_reference": {
      "const": "forward_centerline",
      "default": "forward_centerline",
      "title": "Side Reference",
      "type": "string"
    },
    "join": {
      "enum": [
        "bevel",
        "miter",
        "round"
      ],
      "title": "Join",
      "type": "string"
    },
    "miter_limit": {
      "default": 4,
      "minimum": 1,
      "title": "Miter Limit",
      "type": "number"
    },
    "cap": {
      "enum": [
        "butt",
        "square",
        "round"
      ],
      "title": "Cap",
      "type": "string"
    },
    "construction_source_refs": {
      "items": {
        "$ref": "#/$defs/DiagnosticSourceRef"
      },
      "minItems": 1,
      "title": "Construction Source Refs",
      "type": "array"
