{
  "$defs": {
    "DescriptionCandidate": {
      "additionalProperties": false,
      "properties": {
        "carried_uncertainty_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Carried Uncertainty Ids",
          "type": "array"
        },
        "closing_words": {
          "minLength": 1,
          "title": "Closing Words",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "opening_words": {
          "minLength": 1,
          "title": "Opening Words",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "role": {
          "enum": [
            "operative",
            "historical",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "selected_text": {
          "$ref": "#/$defs/TranscriptReference"
        },
        "separators": {
          "items": {
            "type": "string"
          },
          "title": "Separators",
          "type": "array"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/SelectionSpan"
          },
          "minItems": 1,
          "title": "Spans",
          "type": "array"
        },
        "unresolved_references": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unresolved References",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "role",
        "selected_text",
        "spans",
        "separators",
        "opening_words",
        "closing_words",
        "rationale",
        "unresolved_references",
        "carried_uncertainty_ids"
      ],
      "title": "DescriptionCandidate",
      "type": "object"
    },
    "SelectionSpan": {
      "additionalProperties": false,
      "properties": {
        "end_byte": {
          "minimum": 0,
          "title": "End Byte",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "page_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Page Id",
          "type": "string"
        },
        "start_byte": {
          "minimum": 0,
          "title": "Start Byte",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "page_id",
        "start_byte",
        "end_byte",
        "start_line",
        "end_line"
      ],
      "title": "SelectionSpan",
      "type": "object"
    },
    "TranscriptReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "path"
      ],
      "title": "TranscriptReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acquisition_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "title": "Acquisition Id",
      "type": "string"
    },
    "acquisition_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acquisition Sha256"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/DescriptionCandidate"
      },
      "minItems": 1,
      "title": "Candidates",
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "title": "Id",
      "type": "string"
    },
    "request": {
      "minLength": 1,
      "title": "Request",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_instructions": {
      "minLength": 1,
      "title": "Selection Instructions",
      "type": "string"
    },
    "transcript_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transcript Sha256"
    }
  },
  "required": [
    "id",
    "acquisition_id",
    "request",
    "selection_instructions",
    "candidates"
  ],
  "title": "DescriptionSelectionRecord",
  "type": "object"
}
