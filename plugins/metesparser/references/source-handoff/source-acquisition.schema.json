{
  "$defs": {
    "MissingSourcePage": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "source_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_id",
        "page"
      ],
      "title": "MissingSourcePage",
      "type": "object"
    },
    "SourcePage": {
      "additionalProperties": false,
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "source_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "source_id",
        "page",
        "start_line",
        "end_line"
      ],
      "title": "SourcePage",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "attachment_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attachment Id"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "page_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Count"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "id"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "SourceUncertainty": {
      "additionalProperties": false,
      "properties": {
        "affected_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Field"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "page_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Page Ids",
          "type": "array"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "source_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "SourceUncertainty",
      "type": "object"
    },
    "TranscriptReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "path"
      ],
      "title": "TranscriptReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conversion_instructions": {
      "minLength": 1,
      "title": "Conversion Instructions",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "title": "Id",
      "type": "string"
    },
    "method": {
      "minLength": 1,
      "title": "Method",
      "type": "string"
    },
    "missing_pages": {
      "items": {
        "$ref": "#/$defs/MissingSourcePage"
      },
      "title": "Missing Pages",
      "type": "array"
    },
    "model": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "page_map": {
      "items": {
        "$ref": "#/$defs/SourcePage"
      },
      "title": "Page Map",
      "type": "array"
    },
    "read_pages": {
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Read Pages",
      "type": "array"
    },
    "request": {
      "minLength": 1,
      "title": "Request",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "supplied_pages": {
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Supplied Pages",
      "type": "array"
    },
    "transcript": {
      "$ref": "#/$defs/TranscriptReference"
    },
    "uncertainties": {
      "items": {
        "$ref": "#/$defs/SourceUncertainty"
      },
      "title": "Uncertainties",
      "type": "array"
    },
    "unreadable_pages": {
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Unreadable Pages",
      "type": "array"
    }
  },
  "required": [
    "id",
    "method",
    "request",
    "conversion_instructions",
    "sources",
    "transcript",
    "page_map",
    "supplied_pages",
    "read_pages",
    "unreadable_pages",
    "missing_pages",
    "uncertainties"
  ],
  "title": "SourceAcquisitionRecord",
  "type": "object"
}
